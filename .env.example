# Copy this file to .env and fill in real values.
# This root .env is consumed by docker-compose.yml (Postgres credentials
# and the values passed into the api container's environment).

POSTGRES_USER=finpilot
POSTGRES_PASSWORD=changeme
POSTGRES_DB=finpilot

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-a-random-64-character-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-character-hex-string
