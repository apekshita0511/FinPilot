# Copy this file to .env for running the API outside Docker
# (npm run dev:api against a Postgres exposed on localhost:5432,
# e.g. via `docker compose up postgres`).

NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://finpilot:changeme@localhost:5432/finpilot?schema=public
JWT_ACCESS_SECRET=replace-with-a-random-64-character-hex-string
JWT_REFRESH_SECRET=replace-with-a-different-random-64-character-hex-string
WEB_ORIGIN=http://localhost:5173
