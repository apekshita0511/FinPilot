{
  "name": "finpilot",
  "private": true,
  "version": "0.0.0",
  "description": "FinPilot — personal finance and budgeting app",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "lint": "npm run lint --workspace=apps/web && npm run lint --workspace=apps/api",
    "db:migrate": "npm run prisma:migrate --workspace=apps/api",
    "db:seed": "npm run prisma:seed --workspace=apps/api"
  },
  "allowScripts": {
    "@prisma/client@6.19.3": true,
    "bcrypt@5.1.1": true,
    "esbuild@0.28.2": true,
    "prisma@6.12.0": true,
    "@prisma/engines@6.12.0": true
  }
}
